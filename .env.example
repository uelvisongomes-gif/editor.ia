# --- Cliente (browser) ---------------------------------------------------
# Chaves públicas (podem aparecer no bundle; RLS do Supabase é o que protege).
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...ANON_KEY_AQUI

# --- Servidor (Vercel functions) -----------------------------------------
# NUNCA prefixe com VITE_ — essas nunca podem vazar pro cliente.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE=eyJhbGciOi...SERVICE_ROLE_KEY_AQUI

# Chave da OpenAI (já existente).
OPENAI_API_KEY=sk-...
